# Password untuk masuk ke aplikasi
APP_PASSWORD=ganti-dengan-password-anda

# String acak minimal 32 karakter untuk menandatangani sesi login.
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# Diisi otomatis oleh Vercel saat Upstash Redis ditambahkan dari Marketplace.
# Kosongkan saat development lokal: data disimpan di .data/transactions.json
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
